# Nexus Intelligence // Frontend Environment Configuration
# Set VITE_API_BASE_URL to point to your live Python/FastAPI or Node backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set VITE_USE_MOCK=false to strictly use backend endpoints.
# Set VITE_USE_MOCK=true (default) to enable self-contained offline demo mode with domain intelligence presets.
VITE_USE_MOCK=true
