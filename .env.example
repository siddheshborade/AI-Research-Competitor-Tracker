# ===================================================================
# AGENTX24 — Master Environment Configuration Template
# ===================================================================

# -------------------------------------------------------------------
# Backend Settings (FastAPI + SQLAlchemy + ReAct Engine)
# -------------------------------------------------------------------
PROJECT_NAME="AGENTX24 Intelligence API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./agentx.db

# LLM & Agent Configuration (Gemini / OpenAI compatible)
# Note: AGENTX24 includes deterministic fallback logic if keys are unset
LLM_API_KEY=
GEMINI_API_KEY=

# External Intelligence Providers
# Web Search (Tavily, Serper, Google Custom Search)
SEARCH_API_KEY=
WEB_SEARCH_API_KEY=

# Research Paper Intelligence (Semantic Scholar, Europe PMC, ArXiv)
RESEARCH_API_KEY=

# Agent Execution Limits
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS_PER_RUN=6
EXTERNAL_API_TIMEOUT_SECONDS=10.0

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -------------------------------------------------------------------
# Frontend Settings (Vite + React 19)
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK=false
