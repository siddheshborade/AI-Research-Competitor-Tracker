# AGENTX24 Environment Configuration

# Application
PROJECT_NAME="AGENTX24 Intelligence API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"

# Database Configuration
# PostgreSQL (Production): postgresql+psycopg2://user:password@localhost:5432/agentx_db
# SQLite (Local Dev): sqlite:///./agentx.db
DATABASE_URL="sqlite:///./agentx.db"

# LLM & External Intelligence APIs (Leave empty to activate deterministic demo fallback)
LLM_API_KEY=""
SEARCH_API_KEY=""
WEB_SEARCH_API_KEY=""
RESEARCH_API_KEY=""

# CORS Settings (Comma-separated allowed frontend origins)
FRONTEND_URL="http://localhost:3000,http://localhost:5173"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Server Configuration
HOST="0.0.0.0"
PORT=8000
